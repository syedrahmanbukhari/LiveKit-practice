{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/css/styles.css",
      "dest": "/public/css/styles.css"
    },
    {
      "src": "/js/home.js",
      "dest": "/public/js/home.js"
    },
    {
      "src": "/js/join.js",
      "dest": "/public/js/join.js"
    },
    {
      "src": "/js/meeting.js",
      "dest": "/public/js/meeting.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
